{% comment %}
  Drop: anuncio de colección con coordenadas en lugar de fechas gritadas.
  Foto en escala de grises cortada a 60°, tag naranja «DROP» como única señal.
{% endcomment %}

<section class="drop{% if settings.grano %} grano{% endif %}">
  {% if section.settings.imagen != blank %}
    <div class="drop__media">
      {{
        section.settings.imagen
        | image_url: width: 2000
        | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: section.settings.imagen.alt
      }}
    </div>
  {% endif %}

  <div class="drop__interior">
    <div class="drop__cabecera">
      {% if section.settings.en_vivo %}
        <span class="tag tag--naranja"><span class="tag__punto"></span>{{ section.settings.etiqueta | escape }}</span>
      {% else %}
        <span class="tag" style="color: var(--blanco-frio)">{{ section.settings.etiqueta | escape }}</span>
      {% endif %}
      {% if section.settings.codigo != blank %}
        <span class="tag tag--suave" style="color: #a3a19c">{{ section.settings.codigo | escape }}</span>
      {% endif %}
    </div>

    <div class="drop__cuerpo">
      {% if section.settings.nombre != blank %}
        <h2 class="display-l revelado">{{ section.settings.nombre | escape }}</h2>
      {% endif %}
      {% if section.settings.texto != blank %}
        <p class="subtitulo">{{ section.settings.texto | escape }}</p>
      {% endif %}
      <ul class="drop__datos micro" role="list" style="list-style: none; padding: 0">
        {% if section.settings.fecha != blank %}<li>{{ section.settings.fecha | escape }}</li>{% endif %}
        {% if section.settings.coordenadas != blank %}<li>{{ section.settings.coordenadas | escape }}</li>{% endif %}
        {% if section.settings.bpm != blank %}<li>{{ section.settings.bpm | escape }}</li>{% endif %}
      </ul>
      {% if section.settings.boton_texto != blank %}
        <a class="boton boton--primario" href="{{ section.settings.boton_url | default: section.settings.coleccion.url | default: routes.collections_url }}">
          {{- section.settings.boton_texto | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Drop",
  "settings": [
    { "type": "image_picker", "id": "imagen", "label": "Imagen" },
    { "type": "text", "id": "etiqueta", "label": "Etiqueta", "default": "DROP" },
    { "type": "checkbox", "id": "en_vivo", "label": "Drop activo (tag naranja)", "default": true },
    { "type": "text", "id": "codigo", "label": "Código", "default": "SØ/002" },
    { "type": "text", "id": "nombre", "label": "Nombre", "default": "SØ/002 — SODIO" },
    { "type": "text", "id": "texto", "label": "Texto", "default": "150 piezas. Sin reposición." },
    { "type": "text", "id": "fecha", "label": "Fecha", "default": "2026.11.14 — 22:00" },
    { "type": "text", "id": "coordenadas", "label": "Coordenadas", "default": "N 00°00′ W 00°00′" },
    { "type": "text", "id": "bpm", "label": "BPM", "default": "132 BPM" },
    { "type": "collection", "id": "coleccion", "label": "Colección" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Ver drop" },
    { "type": "url", "id": "boton_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Drop" }]
}
{% endschema %}
