{% comment %}
  Listado de colección: título `display-l`, descripción en 4/12, filtros nativos de Shopify
  (talla, disponibilidad, precio… configurables con la app Search & Discovery; si no hay,
  filtra por etiquetas),
  orden y grid de producto 4/2 con hairlines.
{% endcomment %}

{%- liquid
  assign orden_actual = collection.sort_by | default: collection.default_sort_by
-%}

<section
  class="coleccion coleccion--{{ section.settings.columnas }}col{% if section.settings.tema == 'galeria' %} tema-galeria{% endif %}"
  style="--proporcion: {{ section.settings.proporcion }};{% case section.settings.encuadre %}{% when 'recortar' %} --ajuste-foto: cover;{% when 'completo' %} --ajuste-foto: contain;{% endcase %}"
>
  {% if section.settings.mostrar_cabecera %}
  <div class="pagina coleccion__cabecera">
    <div class="grid-12">
      <p class="etiqueta suave" style="grid-column: 1 / -1">
        {{ settings.codigo_coleccion }} — {{ 'coleccion.piezas' | t: count: collection.products_count }}
      </p>
      <h1 class="display-l coleccion__titulo">{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="coleccion__descripcion cuerpo-s rte">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <div class="pagina barra-filtros">
    <div class="filtros-tags">
      {% if section.settings.mostrar_filtros and collection.filters.size > 0 %}
        <form class="filtros" action="{{ collection.url }}" method="get" data-filtros>
          {% if collection.sort_by != blank %}
            <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
          {% endif %}

          {% for filter in collection.filters %}
            <details class="filtro">
              <summary class="tag{% if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil %} tag--invertido{% endif %}">
                {{- filter.label | escape -}}
                {%- if filter.active_values.size > 0 %} [{{ filter.active_values.size }}]{% endif -%}
              </summary>

              <div class="filtro__panel">
                {% case filter.type %}
                  {% when 'list', 'boolean' %}
                    <ul class="filtro__lista" role="list">
                      {% for value in filter.values %}
                        <li>
                          <label class="filtro__opcion{% if value.count == 0 and value.active == false %} filtro__opcion--vacia{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                            >
                            <span>{{ value.label | escape }}</span>
                            <span class="suave">{{ value.count }}</span>
                          </label>
                        </li>
                      {% endfor %}
                    </ul>
                  {% when 'price_range' %}
                    {%- liquid
                      assign max_precio = filter.range_max | divided_by: 100
                    -%}
                    <div class="filtro__rango">
                      <div class="campo">
                        <label class="campo__label" for="{{ filter.min_value.param_name }}-{{ section.id }}">Desde</label>
                        <input
                          class="campo__input"
                          id="{{ filter.min_value.param_name }}-{{ section.id }}"
                          type="number"
                          inputmode="numeric"
                          name="{{ filter.min_value.param_name }}"
                          value="{% if filter.min_value.value != nil %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}"
                          min="0"
                          placeholder="0"
                        >
                      </div>
                      <div class="campo">
                        <label class="campo__label" for="{{ filter.max_value.param_name }}-{{ section.id }}">Hasta</label>
                        <input
                          class="campo__input"
                          id="{{ filter.max_value.param_name }}-{{ section.id }}"
                          type="number"
                          inputmode="numeric"
                          name="{{ filter.max_value.param_name }}"
                          value="{% if filter.max_value.value != nil %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}"
                          min="0"
                          placeholder="{{ max_precio }}"
                        >
                      </div>
                      <button type="submit" class="boton boton--secundario">{{ 'coleccion.aplicar' | t }}</button>
                    </div>
                {% endcase %}
              </div>
            </details>
          {% endfor %}

          <noscript><button type="submit" class="boton boton--secundario">{{ 'coleccion.aplicar' | t }}</button></noscript>
        </form>

        {%- liquid
          assign hay_activos = false
          for filter in collection.filters
            if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
              assign hay_activos = true
            endif
          endfor
        -%}
        {% if hay_activos %}
          <div class="filtros-activos">
            {% for filter in collection.filters %}
              {% for value in filter.active_values %}
                <a class="tag tag--invertido" href="{{ value.url_to_remove }}" aria-label="{{ 'coleccion.quitar_filtro' | t: filtro: value.label }}">
                  {{- value.label | escape }} ×
                </a>
              {% endfor %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                  <a class="tag tag--invertido" href="{{ filter.url_to_remove }}">
                    {{- filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} ×
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
            <a class="tag tag--suave" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'coleccion.limpiar' | t }}</a>
          </div>
        {% endif %}
      {% elsif section.settings.mostrar_tags and collection.all_tags.size > 0 %}
        <a
          class="tag{% if current_tags == blank %} tag--invertido{% endif %}"
          href="{{ collection.url }}"
        >
          {{- 'coleccion.todas' | t -}}
        </a>
        {% for tag in collection.all_tags limit: 12 %}
          {% if current_tags contains tag %}
            {{ tag | link_to_remove_tag: tag | replace: '<a ', '<a class="tag tag--invertido" ' }}
          {% else %}
            {{ tag | link_to_tag: tag | replace: '<a ', '<a class="tag" ' }}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    <div class="campo" style="flex-direction: row; align-items: center; gap: var(--space-3)">
      <label class="campo__label" for="orden-{{ section.id }}">{{ 'coleccion.ordenar' | t }}</label>
      <select id="orden-{{ section.id }}" data-orden>
        {% for opcion in collection.sort_options %}
          <option
            value="{{ opcion.value }}"
            {% if opcion.value == orden_actual %}
              selected
            {% endif %}
          >
            {{ opcion.name }}
          </option>
        {% endfor %}
      </select>
    </div>
  </div>

  {% paginate collection.products by section.settings.por_pagina %}
    <div class="pagina" style="padding-left: 0; padding-right: 0">
      {% if collection.products.size > 0 %}
        <ul class="grid-producto" role="list">
          {% for product in collection.products %}
            {%- liquid
              case section.settings.columnas
                when '2'
                  assign tamanos = '(min-width: 1024px) 50vw, 50vw'
                when '3'
                  assign tamanos = '(min-width: 1024px) 33vw, 50vw'
                else
                  assign tamanos = '(min-width: 1024px) 25vw, 50vw'
              endcase
            -%}
            <li>{% render 'tarjeta-producto', product: product, indice: forloop.index, tamanos: tamanos %}</li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="pagina vacio">
          <p class="titulo">{{ 'coleccion.vacia' | t }}</p>
        </div>
      {% endif %}
    </div>

    {% render 'paginacion', paginate: paginate %}
  {% endpaginate %}

  <div style="height: var(--space-16)"></div>
</section>

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "range", "id": "por_pagina", "label": "Piezas por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "mostrar_cabecera", "label": "Mostrar título de la colección", "info": "Desactívalo si la plantilla tiene una portada de categoría.", "default": true },
    {
      "type": "select",
      "id": "columnas",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "2", "label": "2 — piezas grandes" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "proporcion",
      "label": "Proporción de imagen",
      "options": [
        { "value": "4 / 5", "label": "4:5 — retrato" },
        { "value": "2 / 3", "label": "2:3 — alta" },
        { "value": "3 / 2", "label": "3:2 — horizontal" },
        { "value": "1 / 1", "label": "1:1 — cuadrada" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "encuadre",
      "label": "Encuadre de fotos",
      "options": [
        { "value": "global", "label": "Según la configuración del tema" },
        { "value": "recortar", "label": "Recortar para llenar" },
        { "value": "completo", "label": "Completo (sin recortes)" }
      ],
      "default": "global"
    },
    {
      "type": "select",
      "id": "tema",
      "label": "Tema",
      "options": [
        { "value": "noche", "label": "Noche" },
        { "value": "galeria", "label": "Galería (claro)" }
      ],
      "default": "noche"
    },
    { "type": "checkbox", "id": "mostrar_filtros", "label": "Filtros (talla, precio, disponibilidad)", "info": "Se configuran en la app Search & Discovery de Shopify.", "default": true },
    { "type": "checkbox", "id": "mostrar_tags", "label": "Filtros por etiqueta (si no hay filtros)", "default": true }
  ]
}
{% endschema %}
