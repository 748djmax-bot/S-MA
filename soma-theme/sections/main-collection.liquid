{% comment %}
  Listado de colección: título `display-l`, descripción en 4/12, filtros por etiqueta,
  orden y grid de producto 4/2 con hairlines.
{% endcomment %}

{%- liquid
  assign orden_actual = collection.sort_by | default: collection.default_sort_by
-%}

<section>
  <div class="pagina coleccion__cabecera">
    <div class="grid-12">
      <p class="etiqueta suave" style="grid-column: 1 / -1">
        {{ settings.codigo_coleccion }} — {{ 'coleccion.piezas' | t: count: collection.products_count }}
      </p>
      <h1 class="display-l coleccion__titulo">{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="coleccion__descripcion cuerpo-s rte">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>

  <div class="pagina barra-filtros">
    <div class="filtros-tags">
      {% if section.settings.mostrar_tags and collection.all_tags.size > 0 %}
        <a
          class="tag{% if current_tags == blank %} tag--invertido{% endif %}"
          href="{{ collection.url }}"
        >
          {{- 'coleccion.todas' | t -}}
        </a>
        {% for tag in collection.all_tags limit: 12 %}
          {% if current_tags contains tag %}
            {{ tag | link_to_remove_tag: tag | replace: '<a ', '<a class="tag tag--invertido" ' }}
          {% else %}
            {{ tag | link_to_tag: tag | replace: '<a ', '<a class="tag" ' }}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    <div class="campo" style="flex-direction: row; align-items: center; gap: var(--space-3)">
      <label class="campo__label" for="orden-{{ section.id }}">{{ 'coleccion.ordenar' | t }}</label>
      <select id="orden-{{ section.id }}" data-orden>
        {% for opcion in collection.sort_options %}
          <option
            value="{{ opcion.value }}"
            {% if opcion.value == orden_actual %}
              selected
            {% endif %}
          >
            {{ opcion.name }}
          </option>
        {% endfor %}
      </select>
    </div>
  </div>

  {% paginate collection.products by section.settings.por_pagina %}
    <div class="pagina" style="padding-left: 0; padding-right: 0">
      {% if collection.products.size > 0 %}
        <ul class="grid-producto" role="list">
          {% for product in collection.products %}
            <li>{% render 'tarjeta-producto', product: product, indice: forloop.index %}</li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="pagina vacio">
          <p class="titulo">{{ 'coleccion.vacia' | t }}</p>
        </div>
      {% endif %}
    </div>

    {% render 'paginacion', paginate: paginate %}
  {% endpaginate %}
</section>

<div style="height: var(--space-16)"></div>

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "range", "id": "por_pagina", "label": "Piezas por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "mostrar_tags", "label": "Filtros por etiqueta", "default": true }
  ]
}
{% endschema %}
