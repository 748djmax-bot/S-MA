{% comment %}
  Página de contraseña / próximamente: logo desvanecido, corte naranja, coordenadas.
{% endcomment %}

<section class="pagina password registro">
  <span class="corte" aria-hidden="true"></span>

  <div style="display: flex; justify-content: space-between; gap: var(--space-4)" class="micro suave">
    <span>{{ settings.codigo_coleccion }}</span>
    <span>{{ settings.coordenadas }} — {{ settings.bpm }}</span>
  </div>

  <div class="password__logo">
    <img src="{{ 'soma-logo-desvanecido-blanco.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="584" height="250">
  </div>

  <div style="display: grid; gap: var(--space-6); max-width: 560px">
    {%- liquid
      assign claim = section.settings.claim
      if claim == blank
        assign claim = 'password.titulo' | t
      endif
    -%}
    <h1 class="display-l">{{ claim | escape }}</h1>
    {% if shop.password_message != blank %}
      <p class="subtitulo">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div class="mensaje-error" role="alert" style="margin-bottom: var(--space-2)">Error — {{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="acceso__form">
        <label class="sr-only" for="password-input">{{ 'password.password' | t }}</label>
        <input class="campo__input" type="password" name="password" id="password-input" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="boton boton--primario">{{ 'password.entrar' | t }}</button>
      </div>
    {% endform %}

    <p class="etiqueta suave">
      {{ 'password.admin' | t }}
      <a href="/admin">{{ 'password.admin_link' | t }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "settings": [{ "type": "text", "id": "claim", "label": "Claim", "default": "NOISE IS EVERYWHERE." }]
}
{% endschema %}
