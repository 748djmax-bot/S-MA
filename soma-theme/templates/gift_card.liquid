{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Unbounded:wght@600;700;800&display=swap"
    >
    {{ 'soma.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main>
      <div class="resumen" style="max-width: 420px; width: 100%; gap: var(--space-6)">
        <div class="header__logo" style="color: var(--tinta)">{% render 'logo-plano' %}</div>
        <p class="etiqueta suave">{{ 'gift_card.titulo' | t }}</p>
        <h1 class="display-l">{{ gift_card.balance | money }}</h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p class="etiqueta">{{ 'gift_card.expirada' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%Y.%m.%d' %}
          <p class="etiqueta suave">{{ 'gift_card.expira' | t: expires_on: expires_on }}</p>
        {% endif %}

        <p class="cuerpo-s">{{ 'gift_card.usar' | t }}</p>
        <p class="tag tag--naranja" style="font-size: 16px; padding: 8px 12px; align-self: flex-start">{{ gift_card.code | format_code }}</p>

        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.wallet' | t }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </div>
    </main>
  </body>
</html>
