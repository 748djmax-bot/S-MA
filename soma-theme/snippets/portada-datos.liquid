{% doc %}
  Lista de datos técnicos (bloques «dato») de la portada de categoría.

  @param {section} section - La sección coleccion-portada
{% enddoc %}

{% if section.blocks.size > 0 %}
  <dl class="portada__datos">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <dt class="micro suave">{{ block.settings.clave | escape }}</dt>
        <dd class="codigo">{{ block.settings.valor | escape }}</dd>
      </div>
    {% endfor %}
  </dl>
{% endif %}
